{
  "name": "radix-daisyui-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tokens:build": "bun tokens/build/style-dictionary.js",
    "fmt": "bunx biome format --write src tests tools docs package.json biome.jsonc bunfig.toml",
    "lint": "bunx biome ci src tests tools docs",
    "check:types": "tsc --noEmit --skipLibCheck",
    "test": "bun test --preload ./tests/setup-happy-dom.ts --preload ./tests/setup-snapshot-guard.ts",
    "test:a11y": "vitest --run --config vitest.a11y.config.ts",
    "test:a11y:watch": "vitest --watch --config vitest.a11y.config.ts",
    "test:e2e": "playwright test",
    "lint:ftl-vars": "bun run scripts/check-fluent-vars.ts",
    "test:all": "bun lint && bun check:types && bun test && bun run test:a11y && bun run lint:ftl-vars && bun semantic && bun test:e2e",
    "ff": "bunx --bun @tailwindcss/cli --input src/index.css --output tmp/tailwind.css --verbose && rm -f tmp/tailwind.css && bun run test:all && uvx --from moz-fluent-linter moz-fluent-lint public/locales/",
    "semantic:lint": "bunx biome ci src tests tools docs && bun run lint:classlist && bun run lint:class-duplicates && uvx semgrep --config tools/semgrep-semantic.yml --include src/**/*.tsx --include tests/**/*.tsx && bunx stylelint 'src/**/*.css' --config tools/stylelint.config.cjs",
    "semantic": "bun run semantic:lint",
    "lint:classlist": "bun run scripts/check-classlist-length.ts",
    "lint:class-duplicates": "bun run scripts/find-near-duplicate-classes.ts"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-router": "^1.170.45",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.50",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fluent": "^2.0.0",
    "i18next-fluent-backend": "^1.0.1",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@fluent/syntax": "^0.19.0",
    "@getgrit/cli": "^0.1.0-alpha.1743007075",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "baseline-browser-mapping": "^2.11.30",
    "bun-types": "^1.4.3",
    "happy-dom": "^20.10.6",
    "jest-axe": "^10.0.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "semgrep": "^0.0.1",
    "style-dictionary": "^5.7.0",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
